/* Amharic Dictionary & Text Processing Rules for Eloquence Delta Engine */

/* ========================================== */
/* 1. PUNCTUATION MAPPING (የስርዓተ-ነጥብ አነባበብ) */
/* ========================================== */
"፡"   = " " ;         /* ነጥብ (Space) */
"፣"   = " , " ;       /* ነጠላ ሰረዝ */
"፤"   = " ; " ;       /* ድርብ ሰረዝ */
"፥"   = " : " ;       /* ሁለት ነጥብ */
"፦"   = " : " ;       /* አርአያ ነጥብ */
"፧"   = " ? " ;       /* ጥያቄ ምልክት */
"፨"   = " . " ;       /* ምዕራፍ ማጠቃለያ */

/* ========================================== */
/* 2. ETHIOPIC NUMERALS (የግዕዝ ቁጥሮች)       */
/* ========================================== */
/* ከ 1 እስከ 10 */
"፩"   = "አንድ" ;
"፪"   = "ሁለት" ;
"፫"   = "ሦስት" ;
"፬"   = "አራት" ;
"፭"   = "አምስት" ;
"፮"   = "ስድስት" ;
"፯"   = "ሰባት" ;
"፰"   = "ስምንት" ;
"፱"   = "ዘጠኝ" ;
"፲"   = "አስር" ;

/* ከ 20 እስከ 90 */
"፳"   = "ሀያ" ;
"፴"   = "ሰላሳ" ;
"፵"   = "አርባ" ;
"፭"   = "ሐምሳ" ;
"፷"   = "ስድሳ" ;
"፯"   = "ሰባ" ;
"፰"   = "ሰማንያ" ;
"፺"   = "ዘጠና" ;

/* 100 እና 10,000 */
"፻"   = "መቶ" ;
"፼"   = "እልፍ" ;

/* Compound Ethiopic Numbers (የተጣመሩ የግዕዝ ቁጥሮች) */
"፲፩"  = "አስራ አንድ" ;
"፲፪"  = "አስራ ሁለት" ;
"፲፫"  = "አስራ ሦስት" ;
"፲፬"  = "አስራ አራት" ;
"፲፭"  = "አስራ አምስት" ;
"፲፮"  = "አስራ ስድስት" ;
"፲፯"  = "አስራ ሰባት" ;
"፲፰"  = "አስራ ስምንት" ;
"፲፱"  = "አስራ ዘጠኝ" ;

/* ========================================== */
/* 3. ARABIC DIGITS TO AMHARIC (የአረብኛ ቁጥሮች)*/
/* ========================================== */
"0"   = "ዜሮ" ;
"1"   = "አንድ" ;
"2"   = "ሁለት" ;
"3"   = "ሦስት" ;
"4"   = "አራት" ;
"5"   = "አምስት" ;
"6"   = "ስድስት" ;
"7"   = "ሰባት" ;
"8"   = "ስምንት" ;
"9"   = "ዘጠኝ" ;


/* Amharic Dictionary & Punctuation Rules for Eloquence */

/* Punctuation Mapping (የስርዓተ-ነጥብ አነባበብ) */
"፡"   = " " ;         /* ነጥብ (Space) */
"፣"   = " , " ;       /* ነጠላ ሰረዝ */
"፤"   = " ; " ;       /* ድርብ ሰረዝ */
"፥"   = " : " ;       /* ሁለት ነጥብ */
"፦"   = " : " ;       /* አርአያ ነጥብ */
"፧"   = " ? " ;       /* ጥያቄ ምልክት */
"፨"   = " . " ;       /* አስከሬን / ምዕራፍ ማጠቃለያ */

/* Basic Numbers in Ethiopic (የግዕዝ ቁጥሮች - አማራጭ) */
"፩"   = "አንድ" ;
"፪"   = "ሁለት" ;
"፫"   = "ሦስት" ;
"፬"   = "አራት" ;
"፭"   = "አምስት" ;
"፮"   = "ስድስት" ;
"፯"   = "ሰባት" ;
"፰"   = "ስምንት" ;
"፱"   = "ዘጠኝ" ;
"፲"   = "አስር" ;
